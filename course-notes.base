filters:
  and:
    - file.hasProperty("title")
formulas:
  posts: link(file.name,title)
views:
  - type: table
    name: View
    filters:
      and:
        - file.inFolder("notes")
        - and:
            - file.hasProperty("domain")
    groupBy:
      property: course
      direction: ASC
    order:
      - draft
      - formula.posts
    sort:
      - property: date
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      note.draft: 62
      formula.posts: 745
